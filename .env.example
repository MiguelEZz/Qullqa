# Dominio público (sin https://). Desarrollo: ngrok. Producción: qullqa.us (Porkbun) → VM.
PUBLIC_DOMAIN=obsession-savior-dry.ngrok-free.dev
PUBLIC_URL=https://obsession-savior-dry.ngrok-free.dev

# Postgres + PostGIS (docker, puerto 5434 porque 5432/5433 están ocupados)
POSTGRES_USER=qullqa
POSTGRES_PASSWORD=qullqa_dev_change_me
POSTGRES_DB=qullqa
DATABASE_URL=postgres://qullqa:qullqa_dev_change_me@localhost:5434/qullqa

API_PORT=3000
CADDY_PORT=8080
JWT_SECRET=change_me_to_a_long_random_string

# NASA Earthdata (https://urs.earthdata.nasa.gov → Generate Token). Solo para GPM IMERG / SMAP.
EARTHDATA_TOKEN=

# Microsoft Planetary Computer (opcional: el catálogo STAC es público; la clave solo sube el límite de descargas)
PC_SDK_SUBSCRIPTION_KEY=

# Meteomatics: SOLO respaldo/verificación, etiquetado «fuente complementaria, no NASA». Nunca reemplaza a POWER.
METEOMATICS_USERNAME=
METEOMATICS_PASSWORD=
